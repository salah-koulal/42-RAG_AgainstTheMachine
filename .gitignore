# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Type checking / linting / testing caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.flake8_cache/

# uv
.uv_cache/

# OS / editor cruft
.DS_Store
*.swp

# Data: corpus, index, datasets and generated outputs are provided or
# regenerated by the evaluator and must not be committed (see subject:
# "Do not include large data files, model weights, or generated outputs").
# Directory layout itself is kept tracked via .gitkeep files.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/datasets/UnansweredQuestions/*
!data/datasets/UnansweredQuestions/.gitkeep
data/datasets/AnsweredQuestions/*
!data/datasets/AnsweredQuestions/.gitkeep
data/output/search_results/*
!data/output/search_results/.gitkeep
data/output/search_results_and_answer/*
!data/output/search_results_and_answer/.gitkeep

# Generated outputs
cache/
evaluations/
data/datasets/private/

# Model weights downloaded from Hugging Face, if cached locally in-repo
models/
*.bin
*.safetensors
*.gguf
moulinette
